# =====================================================================
# .env.example – Plantilla de Variables de Entorno
# =====================================================================
# INSTRUCCIONES:
#   - Copia este archivo como ".env" para desarrollo local (nunca subir .env al repo)
#   - En Azure App Service: configura estas mismas claves en
#     Portal Azure → App Service → Configuración → Configuración de la aplicación
# =====================================================================

# ── Base de Datos MySQL / Azure Database for MySQL ───────────────────
# Formato local:    jdbc:mysql://localhost:3306/bd_portafolio?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# Formato Azure:    jdbc:mysql://<servidor>.mysql.database.azure.com:3306/bd_portafolio?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/bd_portafolio?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USER=root
DB_PASSWORD=

# ── Puerto del servidor (Azure lo asigna automáticamente con PORT=80) ─
PORT=8080
